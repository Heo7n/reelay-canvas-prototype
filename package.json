{
  "name": "reelay-canvas-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Reelay local application shell and AIGC canvas prototype",
  "scripts": {
    "dev:canvas": "vite --config vite.canvas.config.ts",
    "dev:shell": "vite --config vite.shell.config.ts",
    "dev:server": "tsx watch src/server/start.ts",
    "dev:server:shared": "node scripts/start-shared-server.mjs",
    "start:server": "tsx src/server/start.ts",
    "start": "npm run start:server",
    "build:shell": "tsc -p tsconfig.shell.json --noEmit && vite build --config vite.shell.config.ts",
    "build:preview": "npm run build:shell && node scripts/copy-legacy-canvas.mjs",
    "build": "npm run build:preview",
    "build:experience": "tsc -p tsconfig.shell.json --noEmit && tsx scripts/build-experience.mts",
    "preview:experience": "node scripts/serve-experience.mjs",
    "test:shell": "vitest run --config vitest.shell.config.ts",
    "check:shell": "tsc -p tsconfig.shell.json --noEmit && npm run test:shell",
    "test:server": "vitest run --config vitest.server.config.ts",
    "check:server": "tsc -p tsconfig.server.json --noEmit && npm run test:server && npm run test:db:setup",
    "test:server:postgres": "vitest run --config vitest.server.integration.config.ts",
    "check:server:postgres": "tsc -p tsconfig.server.json --noEmit && npm run test:server:postgres",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "db:migrate": "tsx src/server/db/migrate-command.ts",
    "db:seed": "tsx src/server/db/seed-command.ts",
    "db:setup": "node scripts/setup-local-demo.mjs",
    "test:db:setup": "node --test scripts/setup-local-demo.test.mjs scripts/start-shared-server.test.mjs",
    "worktrees": "node scripts/show-worktrees.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:html": "node scripts/check-html.mjs",
    "test": "node --test scripts/copy-legacy-canvas.test.mjs \"tests/*.test.mjs\"",
    "test:canvas": "npm test",
    "check:canvas": "npm run check:js && npm run check:css && npm run check:html && npm run test:canvas",
    "check:legacy": "npm run check:js && npm run check:config && npm run check:css && npm run check:html && npm test",
    "verify:shell": "npm run check:shell && npm run build:shell",
    "check": "npm run lint && npm run check:docs && npm run check:legacy && npm run check:shell && npm run check:server && npm run check:e2e",
    "db:seed:preview-assets": "tsx src/server/db/seed-preview-assets-command.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:visual": "npm run check:css && npm run check:html",
    "check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "lint": "eslint --cache --max-warnings 0",
    "check:backup:drill": "node --import tsx scripts/backup-restore-drill.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "@vercel/functions": "^3.7.5",
    "fastify": "5.12.1",
    "lucide-react": "^1.25.0",
    "pg": "^8.22.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
