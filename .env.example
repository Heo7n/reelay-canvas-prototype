# Local development only. Copy to .env if these defaults need to change.
POSTGRES_DB=reelay
POSTGRES_USER=reelay
POSTGRES_PASSWORD=reelay-local-only
POSTGRES_PORT=54329
DATABASE_URL=postgresql://reelay:reelay-local-only@127.0.0.1:54329/reelay

# Vercel runtime should use a Supavisor transaction-pooler URL.
# Keep migration credentials separate and out of source control.
# MIGRATION_DATABASE_URL=postgresql://...
# REELAY_DB_POOL_MAX=2
# REELAY_DB_CONNECT_TIMEOUT_MS=15000

# Public prototype initialization only. Enable these temporarily when seeding.
# REELAY_DEPLOYMENT_MODE=preview
# ALLOW_DEMO_SEED=true
